# AICompared — API key configuration
#
# Copy this file to `.env` and fill in the keys for the providers you want to
# compare. `.env` is gitignored, so your real keys never get committed.
#
#   cp .env.example .env
#
# You only need keys for the providers you actually use — the config module
# reports which ones are configured and skips the rest.

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Google OAuth (optional) ---
# Only needed for a user-delegated OAuth flow. For standard Gemini model calls,
# use GOOGLE_API_KEY above instead — that's the simpler, recommended path.
# Create credentials at https://console.cloud.google.com/apis/credentials
# NOTE: the client secret is sensitive — put the real value only in your local
# .env, never here. This file is a committed template and must stay blank.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Callback URL Google redirects back to — must EXACTLY match an "Authorized
# redirect URI" on the OAuth client. For local dev with the built-in server:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Optional. Space- or comma-separated scopes. Defaults to "openid email profile"
# (minimal identity) when unset. Only widen this if you truly need more access.
GOOGLE_OAUTH_SCOPES=
